# Privy App ID (public client ID) from dashboard.privy.io
NEXT_PUBLIC_PRIVY_APP_ID=

# Relay API key from dashboard.relay.link. Server-only, never exposed to the browser.
RELAY_API_KEY=

# Gasless trades: Privy pays gas for the embedded wallet. Requires TEE execution and
# gas sponsorship (Fee sponsorship > Sponsor gas fees, with Base selected) in the Privy Dashboard.
SPONSOR_GAS=false

# Optional settings (defaults shown)
# RELAY_REFERRER=relay-trading-app-example
# QUOTE_TTL_SECONDS=30
# ROUTE_RACING=true            # only takes effect if Relay enabled Route Racing on your key
# ROUTE_RACING_MIN_USD=100
# QUEUE_SELLS=true
# QUEUEING_TTL_SECONDS=3600
# USE_PERMIT=false             # gasless USDC buys via permit
# FAST_FILL=false              # draws on your app balance
# FAST_FILL_MAX_USD=50
# APP_FEE_RECIPIENT=
# APP_FEE_BPS=
# SPONSOR_MAX_USDC=            # e.g. 1000000 = $1 cap per request
