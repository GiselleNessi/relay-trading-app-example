# Privy App ID (public client ID) from dashboard.privy.io
NEXT_PUBLIC_PRIVY_APP_ID=

# Optional. Relay API key from dashboard.relay.link. Server-only, never exposed to the browser.
# Quotes work without it at public rate limits; Route Racing, Fee Sponsorship, and Fast Fill need it.
RELAY_API_KEY=

# Gasless trades for email users: Privy pays gas for the embedded wallet. See the Gas section
# of the README for the Privy Dashboard setup. Cross-chain buys are gasless either way (permit).
SPONSOR_GAS=false

# Optional settings (defaults shown)
# RELAY_REFERRER=relay-trading-app-example  # only sent with an API key
# QUOTE_TTL_SECONDS=30
# ROUTE_RACING=true            # only takes effect if Relay enabled Route Racing on your key
# ROUTE_RACING_MIN_USD=100
# QUEUE_SELLS=true
# QUEUEING_TTL_SECONDS=3600
# USE_PERMIT=true              # cross-chain USDC buys sign a permit instead of sending a transaction
# FAST_FILL=false              # draws on your app balance
# FAST_FILL_AFTER_SECONDS=10   # fast fill only deposits still unindexed after this long
# FAST_FILL_MAX_USD=50
# APP_FEE_RECIPIENT=
# APP_FEE_BPS=
# SPONSOR_MAX_USDC=            # e.g. 1000000 = $1 cap per request
